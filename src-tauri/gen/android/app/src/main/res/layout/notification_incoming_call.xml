<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/pax_call_heading"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/pax_call_decline"
            style="@style/PaxCallNotificationButton"
            android:layout_marginEnd="8dp"
            android:background="@drawable/pax_call_decline_background"
            android:text="@string/pax_call_decline" />

        <Button
            android:id="@+id/pax_call_answer"
            style="@style/PaxCallNotificationButton"
            android:background="@drawable/pax_call_answer_background"
            android:text="@string/pax_call_answer" />

    </LinearLayout>
</LinearLayout>
