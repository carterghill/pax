; CUDA driver entry points used by the Pax NVENC encoder. cuda.h selects
; cuCtxCreate_v2 for CUDA 12 and cuCtxCreate_v4 for CUDA 13.
LIBRARY nvcuda.dll
EXPORTS
    cuArrayDestroy
    cuCtxCreate_v2
    cuCtxCreate_v4
    cuCtxDestroy_v2
    cuCtxGetCurrent
    cuCtxPopCurrent_v2
    cuCtxPushCurrent_v2
    cuCtxSetCurrent
    cuDeviceGet
    cuDeviceGetCount
    cuDeviceGetName
    cuDriverGetVersion
    cuGetErrorName
    cuInit
    cuMemAllocPitch_v2
    cuMemFree_v2
    cuMemcpy2D_v2
    cuMemcpy2DAsync_v2
    cuMemcpy2DUnaligned_v2
